# =================================================================
# Aura Dining & Kitchen - Gemini Live AI Phone Ordering Environment
# =================================================================

# 1. Google Gemini Live API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# 2. Restaurant Telephony Configuration
RESTAURANT_PHONE=+917845742951
# Telephony Provider (Twilio Programmable Voice or SIP Bridge)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 3. WhatsApp Business Cloud Platform (Meta)
# Get credentials from Meta for Developers: https://developers.facebook.com/
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# 4. Server Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./restaurant.db
